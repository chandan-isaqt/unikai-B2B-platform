PORT=5000
NODE_ENV=development

# Local MongoDB Community Server (DO NOT use MongoDB Atlas for local development)
MONGODB_URI=mongodb://127.0.0.1:27017/unikai_db

# JWT Authentication
JWT_SECRET=change_this_in_local_environment
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Default Salesman WhatsApp & Contact
WHATSAPP_NUMBER=+96891234567
SALESMAN_NAME=Sachin
SALESMAN_PHONE=+96891234567
SALESMAN_EMAIL=sachin.sales@unikai.local

# Default Admin Credentials (used by npm run seed)
ADMIN_EMAIL=admin@unikai.local
ADMIN_PASSWORD=Admin@12345

# Optional Cloudinary (leave empty to use local /uploads directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
